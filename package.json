{
  "name": "trackit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview",
    "typecheck": "npm --prefix app run typecheck && tsc -p backend/tsconfig.json",
    "lint": "oxlint",
    "check:flows": "node tools/flows.mjs",
    "setup:auth": "node tools/supabase-auth.mjs",
    "dev:api": "wrangler dev --config backend/wrangler.toml --port 8787",
    "types": "wrangler types backend/worker-configuration.d.ts --config backend/wrangler.toml",
    "db:local": "wrangler d1 execute trackit-db --local --config backend/wrangler.toml --file=backend/schema.sql",
    "deploy": "npm run build && wrangler deploy --config backend/wrangler.toml"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.149.0"
  }
}
