{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // `app/design/` is the design of record, not source: the artboards are exports and
  // `date-container.jsx` is the owner's component as it arrived. Nothing builds them,
  // and their rules are not this project's to satisfy.
  "ignorePatterns": ["app/design/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  }
}
