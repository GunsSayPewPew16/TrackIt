# Copy to app/.env.local and fill in from Settings -> API in the Supabase dashboard.
# Both are public (they ship in the bundle); RLS protects the rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "off" to run the device-only app even when the two values above exist.
VITE_CLOUD=

# Set to "on" to put the portal's Create-account form back. Closed by default: this
# vault holds the accounts its owner made, and Supabase's own sign-up switch is the
# fence behind that decision (see supabase/README.md).
VITE_SIGNUP=
